# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# .env (config Firebase de DEV) vive só em cada máquina. O .env.production
# VAI para o git desde a Secção 11: os valores são públicos (o Firebase
# inclui-os no bundle do cliente) e o EAS Build só vê ficheiros que o git
# conhece. Modelo com os nomes das variáveis: .env.example
.env

# Firebase Admin service-account keys (real secrets — never commit)
*-firebase-adminsdk-*.json
serviceAccount*.json

# Firebase service account keys (seed, jobs locais, FCM V1, eas submit) — NUNCA commitar
serviceAccountKey*.json

# google-services.json do PROD (o da raiz é o do dev). Vai para o EAS como
# variável de ficheiro GOOGLE_SERVICES_JSON — ver DEVELOPMENT.md, Secção 11.
google-services.prod.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Cloud Functions (Secção 6): código compilado e dependências
functions/lib/
functions/node_modules/

# EAS Build: chaves locais (nunca commitar)
credentials.json

# functions/.env NÃO tem segredos (cloud name público + interruptores) — vai para o git
!functions/.env

# Logs e cache da Firebase CLI (o deploy do Hosting cria .firebase/)
firebase-debug.log
firebase-debug.*.log
.firebase/

# Página de progresso gerada por `npm run progress` (publica-se como Artifact,
# não se versiona — ver CLAUDE.md, "Página de progresso")
scripts/out/
