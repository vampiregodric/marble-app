# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# env files with real Firebase config — live only on each machine.
# Template with the variable names: .env.example
.env
.env.production

# Firebase Admin service-account keys (real secrets — never commit)
*-firebase-adminsdk-*.json
serviceAccount*.json

# Firebase service account keys (usadas pelo script de seed) — NUNCA commitar
serviceAccountKey*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Cloud Functions (Secção 6): código compilado e dependências
functions/lib/
functions/node_modules/

# EAS Build: chaves locais (nunca commitar)
credentials.json
