# Firebase — projeto de DESENVOLVIMENTO (marble-studios-dev)
# Lido automaticamente por `npx expo start` / `npx expo start --web`.
#
# Preenche com os valores reais depois de criar o projeto:
# Firebase Console > marble-studios-dev > Definições do projeto > Geral >
# As tuas apps > SDK setup and configuration.
#
# Nota: estes valores não são secretos — o Firebase inclui-os sempre no
# bundle do cliente. A segurança real vem das Firestore Rules
# (ver firestore.rules), não de esconder isto.
EXPO_PUBLIC_FIREBASE_API_KEY=TODO
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=TODO
EXPO_PUBLIC_FIREBASE_PROJECT_ID=TODO
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=TODO
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TODO
EXPO_PUBLIC_FIREBASE_APP_ID=TODO
