# Firebase — projeto de PRODUÇÃO (marble-studios-prod)
# Só é lido numa build de produção real (ex: `eas build --profile production`),
# nunca por `npx expo start`. Ver DEVELOPMENT.md.
#
# Nota: estes valores não são secretos (ver comentário em .env). O projeto
# fica vazio até à Secção 11 (lançamento) — nenhuma build deve apontar
# para aqui antes disso.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyD64pq4KBeIKgnz0DQaFxcCibdGdXF_gIM
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=marble-studios-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=marble-studios-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=marble-studios-prod.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1081673947718
EXPO_PUBLIC_FIREBASE_APP_ID=1:1081673947718:web:cb46810455b7bb774d4847

# Cloudinary (fotos de perfil carregadas pela app, Secção 5b). Cloud name é público;
# o preset unsigned marble-avatars define pasta e limites. Mesma conta que o backoffice.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=kr9bmaqh
EXPO_PUBLIC_CLOUDINARY_PRESET_AVATARS=marble-avatars

# Fotos que o cliente junta a um pedido de orçamento (Secção 7): preset unsigned
# marble-requests (pasta requests, só imagens, 10 MB). Mesma conta Cloudinary.
EXPO_PUBLIC_CLOUDINARY_PRESET_REQUESTS=marble-requests
