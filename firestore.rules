rules_version = '2';

// Regras de segurança do Firestore — Marble Studios.
//
// Estado (Secção 3, 2026-09-03): o login está ligado. A app cria/lê/atualiza
// `clients/{uid}` com o uid do Firebase Auth (ver src/auth/AuthContext.tsx).
// `vehicles` e `notifications` continuam só de leitura para o cliente — quem
// os escreve é a equipa (backoffice/Admin SDK, que ignora estas regras) e o
// script de seed.
//
// "Apagar conta" (RGPD) NÃO usa delete: o cliente anonimiza o próprio doc
// (update, já permitido) e apaga o utilizador do Auth. O doc fica com
// `deletedAt` e sem dados pessoais; como o uid deixa de existir, ninguém o
// volta a ler pelo SDK de cliente. `delete: false` mantém-se de propósito —
// evita que uma sessão comprometida destrua o histórico de trabalhos.
// Estas regras NÃO mudaram na Secção 3; não é preciso novo deploy.
//
// Deploy: npx firebase-tools deploy --only firestore:rules --project dev
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfólio e eventos são conteúdo público de marketing — visíveis sem login.
    match /works/{workId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do cliente — só o próprio (depois da Secção 2 ligar o Auth).
    match /clients/{clientId} {
      allow read, update: if request.auth != null && request.auth.uid == clientId;
      allow create: if request.auth != null && request.auth.uid == clientId;
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.clientId;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.clientId;
      allow write: if false;
    }
  }
}
