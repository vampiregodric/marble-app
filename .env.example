# Modelo dos ficheiros de ambiente. Copia para `.env` (desenvolvimento) e
# `.env.production` (produção) e preenche com os valores da consola Firebase:
#   Project settings → General → Your apps → SDK setup and configuration.
#
# Estes valores não são segredos (o Firebase inclui-os no bundle do
# cliente); a segurança vem das Firestore Rules. Mesmo assim:
#   - `.env` (dev) NÃO vai para o git — vive só em cada máquina;
#   - `.env.production` VAI para o git desde a Secção 11: o EAS Build só vê
#     ficheiros que o git conhece, e é ele que lê este ficheiro
#     (NODE_ENV=production) nas builds `preview`/`production`.
# Nunca ponhas aqui um segredo real (API secrets, chaves privadas): esses
# vivem no Secret Manager (Functions) ou nas variáveis secretas do EAS.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — foto de perfil do cliente (Secção 5b). O cloud name é público;
# o upload é "unsigned" com o preset marble-avatars (pasta avatars, limites
# definidos no preset). Mesma conta que o backoffice usa para os trabalhos.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_PRESET_AVATARS=marble-avatars
# Fotos que o cliente junta a um pedido de orçamento (Secção 7): preset
# unsigned marble-requests (pasta requests, só imagens, 10 MB). Sem ele, o
# formulário não mostra a secção das fotos.
EXPO_PUBLIC_CLOUDINARY_PRESET_REQUESTS=marble-requests
