# Modelo dos ficheiros de ambiente. Copia para `.env` (desenvolvimento) e
# `.env.production` (produção) e preenche com os valores da consola Firebase:
#   Project settings → General → Your apps → SDK setup and configuration.
#
# Os ficheiros `.env` e `.env.production` reais NÃO vão para o git (ver
# .gitignore) — vivem só em cada máquina. Estes valores não são segredos
# (o Firebase inclui-os no bundle do cliente); a segurança vem das
# Firestore Rules. Mesmo assim, ficam fora do repositório por hábito, para
# que qualquer segredo real que venha a ser adicionado aqui no futuro não
# seja publicado por engano.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — foto de perfil do cliente (Secção 5b). O cloud name é público;
# o upload é "unsigned" com o preset marble-avatars (pasta avatars, limites
# definidos no preset). Mesma conta que o backoffice usa para os trabalhos.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_PRESET_AVATARS=marble-avatars
