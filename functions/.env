# Parâmetros NÃO secretos das Cloud Functions (firebase-functions/params).
# Os segredos (CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET) vivem no Secret
# Manager — ver DEVELOPMENT.md, "Cloud Functions".
#
# Cloud name do Cloudinary: público (está no bundle da app e do backoffice).
CLOUDINARY_CLOUD_NAME=kr9bmaqh

# Limpeza automática da foto de perfil no Cloudinary. Só pode ficar "on"
# DEPOIS de os dois segredos existirem no projeto (o deploy falha se os
# declarar sem valor):
#   npx.cmd firebase-tools functions:secrets:set CLOUDINARY_API_KEY --project dev
#   npx.cmd firebase-tools functions:secrets:set CLOUDINARY_API_SECRET --project dev
# Com "off", onClientUpdated regista nos logs o que ficou por apagar e a
# equipa apaga à mão (README do backoffice).
CLOUDINARY_CLEANUP=off
