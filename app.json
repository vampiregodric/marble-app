{
  "expo": {
    "name": "marble-app",
    "slug": "marble-studios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.marble.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "pt": "./locales/pt.json",
      "en": "./locales/en.json"
    },
    "android": {
      "package": "pt.marble.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Marble Studios usa as tuas fotografias só para escolheres a tua foto de perfil e para juntares fotos a um pedido de orçamento.",
          "cameraPermission": "A Marble Studios usa a câmara só para tirares a tua foto de perfil ou uma foto para um pedido de orçamento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C6A15B",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["pt", "en"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2d792556-5f26-493d-8534-3250945a10f0"
      }
    },
    "owner": "marble-studios"
  }
}
